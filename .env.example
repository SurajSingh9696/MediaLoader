# ─── MediaLoader — Environment Variables ────────────────────────────────────

# URL of the deployed Python backend (Railway / Render / Fly.io).
# Leave empty when running locally with yt-dlp installed on your machine.
BACKEND_URL=https://your-backend.railway.app

# (Backend only) Your Vercel frontend URL for CORS.
# Set this on the Railway/Render dashboard, not here.
# ALLOWED_ORIGIN=https://your-app.vercel.app
