# Vercel/frontend app mode
# Set these only on the Vercel deployment to delegate heavy media work.
ENABLE_EXTERNAL_DOWNLOADER_PROXY=true
EXTERNAL_DOWNLOADER_URL=https://your-downloader-service.example.com

# Downloader container mode
# Keep proxy OFF in Docker downloader service to avoid proxy loops.
# ENABLE_EXTERNAL_DOWNLOADER_PROXY=false

# Optional yt-dlp overrides
# YTDLP_PATH=yt-dlp
# YTDLP_COOKIES_FROM_BROWSER=chrome
